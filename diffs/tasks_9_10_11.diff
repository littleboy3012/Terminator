+size_t history_decode_line(const char *enc, size_t len, char *dec, size_t max) {
+    if (!enc || !dec || max == 0) return 0;
+    size_t o = 0;
+    for (size_t i = 0; i < len && o + 1 < max; i++) {
+        if (enc[i] == '\\' && i + 1 < len) {
+            if (enc[i + 1] == 'n') {
+                dec[o++] = '\n';
+                i++;
+            } else if (enc[i + 1] == '\\') {
+                dec[o++] = '\\';
+                i++;
+            } else {
+                dec[o++] = enc[i];
+            }
+        } else if (enc[i] != '\n' && enc[i] != '\r') {
+            dec[o++] = enc[i];
+        }
+    }
+    dec[o] = '\0';
+    return o;
+}
