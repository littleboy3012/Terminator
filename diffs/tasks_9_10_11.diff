+size_t history_encode_line(const char *raw, char *enc, size_t max) {
+    if (!raw || !enc || max < 2) return 0;
+    size_t o = 0;
+    for (size_t i = 0; raw[i] && o + 3 < max; i++) {
+        if (raw[i] == '\\') {
