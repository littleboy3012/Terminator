+    /* Strip trailing newline characters per bash quoting/substitution rules */
+    while (total > 0 && (out_buf[total - 1] == '\n' || out_buf[total - 1] == '\r')) {
+        total--;
+    }
+    out_buf[total] = '\0';
+
+    return (int)total;
