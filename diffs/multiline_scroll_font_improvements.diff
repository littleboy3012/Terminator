+            int ret = shell_execute_pipeline((ShellContext *)ctx, &pipeline);
+            free_pipeline(&pipeline);
+            _exit(ret);
+        }
+        _exit(1);
+    }
+
+    /* Parent process: read output from pipe read end */
+    close(pipefds[1]);
+    size_t total = 0;
+    ssize_t n;
+    while ((n = read(pipefds[0], out_buf + total, max_len - 1 - total)) > 0) {
+        total += (size_t)n;
+        if (total >= max_len - 1) {
+            break;
+        }
+    }
+    close(pipefds[0]);
